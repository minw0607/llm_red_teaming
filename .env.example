# ============================================================
#  llm_red_teaming — provider configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to git.
# ============================================================


# ------------------------------------------------------------
# OPTION A: Azure OpenAI  (reference setup)
# ------------------------------------------------------------
# API-key auth against an Azure-hosted endpoint.
# Works locally; NOT suitable for Google Colab if your endpoint
# is IP-allowlisted.
#
# Two extra headers are required for Azure API Management (APIM)
# gateways — leave blank if you connect directly to the Azure
# OpenAI resource without a gateway layer.
# ------------------------------------------------------------
OPENAI_API_KEY=2d2ecdceb6074767a26352657e124cde
OPENAI_BASE_URL=https://atlas.protiviti.com/Experiment20240821
OPENAI_API_VERSION=2025-04-01-preview
# TARGET_MODEL: your deployment name for the victim/target model
TARGET_MODEL=gpt-5-4-20260305-gs
# JUDGE_MODEL: can be a different (e.g. cheaper) deployment than TARGET_MODEL
JUDGE_MODEL=gpt-4-1-20250414-gs

# Azure APIM gateway (optional — only needed when routing through APIM)
AZURE_APIM_HEADER_NAME=Experiment20240821-Subscription-Key
AZURE_APIM_SUBSCRIPTION_KEY=2d2ecdceb6074767a26352657e124cde


# ------------------------------------------------------------
# OPTION B: OpenAI direct  — works on Colab and locally
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                         # leave blank for default
# OPENAI_API_VERSION=                      # not required for OpenAI
# TARGET_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o


# ------------------------------------------------------------
# OPTION C: Ollama  (local, free, no API key)
# ------------------------------------------------------------
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# TARGET_MODEL=llama3
# JUDGE_MODEL=llama3


# ------------------------------------------------------------
# OPTION D: Groq  (fast inference, free tier available)
# ------------------------------------------------------------
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# TARGET_MODEL=llama-3.1-70b-versatile
# JUDGE_MODEL=llama-3.1-70b-versatile


# ------------------------------------------------------------
# OPTION E: Together AI
# ------------------------------------------------------------
# OPENAI_API_KEY=your-together-key
# OPENAI_BASE_URL=https://api.together.xyz/v1
# TARGET_MODEL=meta-llama/Llama-3-70b-chat-hf
# JUDGE_MODEL=meta-llama/Llama-3-70b-chat-hf


# ------------------------------------------------------------
# OPTION F: LM Studio  (local GUI, free)
# ------------------------------------------------------------
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# TARGET_MODEL=your-loaded-model-name
# JUDGE_MODEL=your-loaded-model-name


# ------------------------------------------------------------
# Local model paths  (for BERTAttack + SemanticAttack)
# ------------------------------------------------------------
# Paths to locally downloaded HuggingFace model weights.
# If left blank, models are downloaded from the HuggingFace Hub
# on first use and cached automatically.
# Leave blank to auto-download from HuggingFace Hub (default).
# Set to a local path to use a cached copy, e.g. ./models/bert-base-uncased
LOCAL_BERT_PATH=
# Leave blank to auto-download, e.g. ./models/all-MiniLM-L6-v2
LOCAL_SENTENCE_TRANSFORMER_PATH=


# ------------------------------------------------------------
# Dataset paths  (optional — repo copies used by default)
# ------------------------------------------------------------
# Override only if you want to use a different local copy of SST-2.
# By default the notebook loads data/sst2/dev.tsv from the repo.
# SST2_PATH=/path/to/your/SST-2


# ------------------------------------------------------------
# Evaluation settings  (optional — defaults shown)
# ------------------------------------------------------------
# NUM_SAMPLES=50           # sentences evaluated per attack
# SLEEP_SEC=1.2            # seconds between API calls
# JBB_N_GOALS=50           # JailbreakBench goals per run
# VIOLATION_THRESHOLD=0.6  # BART-MNLI score for violation verdict
# UNCERTAIN_THRESHOLD=0.4  # below this → manual review
