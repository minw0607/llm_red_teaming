# Explicitly keep the bundled datasets
!data/**

# Downloaded-on-demand dataset caches (HarmBench behaviors, deepset prompt
# injections, BBQ bias benchmark) — fetched at runtime by their loaders
eval_datasets/safety/
eval_datasets/fairness/
eval_datasets/robustness/

